# Required by api/ask.ts (the terminal's portfolio Q&A assistant).
# Get a free key at https://console.groq.com/keys
AI_API_KEY=

# Optional overrides - defaults shown below (Groq's OpenAI-compatible API).
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=openai/gpt-oss-20b

# Required by api/contact.ts (the Contact section's real send).
# Get a free key at https://resend.com/api-keys - sign up with the same
# email you want the contact form to deliver to (louisafful1@gmail.com),
# so Resend's free sandbox sender (no domain verification needed) can send
# to it without extra setup.
RESEND_API_KEY=

# Optional override - defaults to siteConfig.email if unset.
# CONTACT_TO_EMAIL=louisafful1@gmail.com
